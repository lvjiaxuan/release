{
  "name": "lvr",
  "type": "module",
  "version": "2.1.0",
  "private": false,
  "packageManager": "pnpm@10.8.0",
  "description": "My own release cli tool.",
  "author": "lvjiaxuan <471501748@qq.com> (https://github.com/lvjiaxuan)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lvjiaxuan/release"
  },
  "keywords": [
    "bump",
    "changelog",
    "release"
  ],
  "main": "./dist/cli.cjs",
  "bin": {
    "lvr": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run build --watch",
    "build": "tsup src/cli.ts --clean --format=cjs --shims",
    "test": "vitest bump.test.ts",
    "lint": "eslint ",
    "lintf": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "lvr": "jiti src/cli.ts",
    "linkg": "pnpm link --global",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@antfu/utils": "^9.2.0",
    "@types/cli-progress": "^3.11.6",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^22.14.0",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.7.0",
    "@types/yargs": "^17.0.33",
    "changelogen": "^0.6.1",
    "changelogithub": "^13.13.0",
    "cli-progress": "^3.12.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "conventional-recommended-bump": "^11.0.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.2",
    "eslint": "^9.24.0",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.0",
    "human-id": "^4.1.1",
    "jiti": "^2.4.2",
    "lodash.merge": "^4.6.2",
    "ofetch": "^1.4.1",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "semver": "^7.7.1",
    "simple-git-hooks": "^2.12.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "unconfig": "^7.3.1",
    "vitest": "^3.1.1",
    "yargs": "^17.7.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm dlx lint-staged --concurrent false"
  },
  "lint-staged": {
    "*": [
      "bash -c \"pnpm run typecheck\"",
      "eslint --fix"
    ]
  },
  "lv": {
    "release": {
      "commit": "Release: {r}"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
